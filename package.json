{
  "name": "agente-logistico-gemini",
  "version": "1.0.0",
  "description": "Agente Conversacional de Logística e Inventario con @google/genai, TypeScript y validación determinista",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/inventory-and-state.test.ts tests/retry-and-resilience.test.ts tests/conversation-defects-regression.test.ts tests/security-audit.test.ts",
    "test:integration": "vitest run tests/gemini-integration.test.ts",
    "test:openai": "vitest run tests/openai-integration.test.ts",
    "test:web": "vitest run tests/web-multi-provider.test.ts",
    "test:redis": "vitest run tests/redis-distributed.test.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:start": "npm --prefix web run start"
  },
  "keywords": [
    "gemini",
    "google-genai",
    "inventory",
    "logistics",
    "function-calling",
    "state-machine",
    "typescript"
  ],
  "author": "",
  "private": true,
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@upstash/redis": "^1.40.0",
    "dotenv": "^16.4.7",
    "openai": "^7.45.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
