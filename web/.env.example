# ==============================================================================
# VARIABLES DE ENTORNO — AGENTE LOGÍSTICO WEB (NEXT.JS + VERCEL)
# ==============================================================================

# Modelos de Lenguaje por Defecto (Opcionales, del lado del servidor)
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini

# Persistencia Externa de Sesiones y Autorizaciones (Recomendado para Vercel Serverless)
# Crea una base de datos gratuita en: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://tu-db-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_token_upstash_aqui

# NOTA DE SEGURIDAD BYOK:
# Las API Keys de OpenAI y Gemini NO se colocan en este archivo ni se exponen públicamente.
# Cada usuario introduce su clave directamente a través de la interfaz web en memoria volátil.
