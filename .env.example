# Clave de API de Google Gemini (requerida para ejecución en vivo)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo sugerido y estable probado con éxito: gemini-3.5-flash-lite
# (También admite gemini-3.8-flash según la disponibilidad de servicio y cuota de tu cuenta)
GEMINI_MODEL=gemini-3.5-flash-lite

# Fuente de datos de inventario: 'mock' (PDF test) o 'unstructured' (inventario auditado)
INVENTORY_SOURCE=mock
